chroma_db/
chroma/
faiss_index/
qdrant_storage/
lancedb/
vectorstore/
*.sqlite3
*.db
*.faiss
*.pkl

# --- Model & Embedding Caches ---
.cache/
huggingface/
nltk_data/
tiktoken_cache/
models/
*.bin
*.safetensors
*.gguf

# --- Data & Documents (Optional: keep small sample data, ignore large dumps) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/*.md
!data/*.pdf
!data/*.docx
*.csv
*.parquet
*.jsonl

# --- Jupyter Notebooks & Logs ---
.ipynb_checkpoints/
logs/
*.log
mlruns/
wandb/

# --- IDE & OS Specific (macOS) ---
.DS_Store
