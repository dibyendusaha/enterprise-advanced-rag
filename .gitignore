# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
credentials.json

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
.conda/

# --- Python Cache & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- RAG Vector Stores & Local Databases ---
